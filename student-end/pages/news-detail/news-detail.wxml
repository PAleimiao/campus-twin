<!-- pages/news-detail/news-detail.wxml —— 资讯详情 -->
<view class="page" style="--accent:{{theme.accent}}; --accent-soft:{{theme.soft}};">

  <view class="card">
    <image wx:if="{{item.image}}" class="cover" src="{{item.image}}" mode="aspectFill"></image>
    <view class="title">{{item.title}}</view>
    <view class="meta" wx:if="{{item.date}}">{{item.date}}</view>
    <view class="content">{{item.content || '暂无正文内容。'}}</view>
  </view>
</view>

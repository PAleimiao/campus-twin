/* pages/timetable/timetable.wxss */
.page { padding-bottom: 60rpx; }

/* 空状态 */
.empty { padding: 140rpx 60rpx; text-align: center; }
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 32rpx; color: var(--text); margin-top: 28rpx; line-height: 1.6; }
.empty-sub { margin-top: 14rpx; }

/* 网格容器 */
.tt-wrap {
  margin: 20rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 16rpx 0 20rpx;
  overflow: hidden;
}
.tt-cap { font-size: 24rpx; color: var(--text2); text-align: center; margin-bottom: 6rpx; }
.tt { position: relative; margin: 0 auto; }

/* 表头 */
.hd {
  position: absolute; top: 0; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text2);
}
.hd-today { color: var(--accent); font-weight: 600; }

/* 节次标签 */
.rl {
  position: absolute; left: 0; width: 52rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: var(--text2); text-align: center;
}

/* 网格线 */
.vl { position: absolute; top: 0; width: 1rpx; background: #f0f0f5; }
.hl { position: absolute; height: 1rpx; background: #f0f0f5; }

/* 课程块 */
.blk {
  position: absolute; border-radius: 12rpx; box-sizing: border-box;
  padding: 8rpx 8rpx; overflow: hidden;
}
.blk-name { font-size: 21rpx; font-weight: 600; line-height: 1.25; }
.blk-loc { font-size: 16rpx; opacity: .85; margin-top: 4rpx; line-height: 1.2; }

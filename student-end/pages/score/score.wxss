/* pages/score/score.wxss */
.avg-card { text-align: center; padding: 36rpx; }
.avg-label { font-size: 26rpx; color: var(--text2); }
.avg-num { font-size: 72rpx; font-weight: 700; color: var(--accent); margin-top: 8rpx; }

.sc { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; }
.sc-name { font-size: 32rpx; font-weight: 600; color: var(--text); }
.sc-info { font-size: 24rpx; color: var(--text2); margin-top: 6rpx; }
.sc-score { font-size: 46rpx; font-weight: 700; }
.pass { color: var(--accent); }
.fail { color: #ff5a5a; }

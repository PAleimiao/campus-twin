/* pages/announce/announce.wxss */
.list { padding-bottom: 40rpx; }
.item { padding: 28rpx 32rpx; }
.row { display: flex; align-items: flex-start; }
.title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--text); }
.meta { font-size: 24rpx; color: var(--text2); margin-top: 10rpx; }
.content { font-size: 28rpx; color: var(--text); line-height: 1.7; margin-top: 18rpx; white-space: pre-wrap; }
.more { font-size: 24rpx; margin-top: 12rpx; }

/* pages/ai/ai.wxss */
.page { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

.chat { flex: 1; padding: 24rpx; box-sizing: border-box; }
.pad { height: 40rpx; }

.msg { display: flex; margin-bottom: 24rpx; }
.msg.user { justify-content: flex-end; }
.msg.ai { justify-content: flex-start; }
.bubble {
  max-width: 74%;
  padding: 22rpx 26rpx;
  font-size: 29rpx;
  line-height: 1.6;
  border-radius: 20rpx;
  background: #fff;
  color: var(--text);
  box-shadow: 0 4rpx 16rpx rgba(40, 40, 80, .06);
}
.msg.user .bubble { background: var(--accent); color: #fff; }

/* 气泡 + 来源标记竖排，标记才不会把气泡挤歪 */
.msg-col { display: flex; flex-direction: column; max-width: 74%; }
.msg.ai .msg-col { align-items: flex-start; }
.msg.user .msg-col { align-items: flex-end; }
.tag {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9a9aa8;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f3f4f9;
}
/* 等待中的气泡 */
.typing { color: #9a9aa8; }
.typing .dot { margin-left: 2rpx; }
.typing-main { font-size: 26rpx; }
.typing-tip { margin-top: 8rpx; font-size: 22rpx; color: #b6b9c8; }

/* 思考过程：折叠块，点标题展开 */
.think {
  margin-bottom: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 1rpx dashed #d8dbe8;
  max-width: 100%;
}
.think-head { display: flex; align-items: center; }
.think-icon { font-size: 22rpx; color: #8b8fa8; margin-right: 8rpx; }
.think-title { font-size: 22rpx; color: #6b6f8a; }
.think-len { margin-left: auto; font-size: 20rpx; color: #a8abbd; }
.think-body {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e6e8f2;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7a7e96;
  max-height: 400rpx;
  overflow-y: auto;
  word-break: break-all;
}

.inputbar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #f0f0f5;
}
.ipt { flex: 1; background: #f3f4f9; border-radius: 999rpx; padding: 20rpx 28rpx; font-size: 29rpx; }
.send {
  background: var(--accent); color: #fff; font-size: 28rpx;
  padding: 18rpx 36rpx; border-radius: 999rpx;
}

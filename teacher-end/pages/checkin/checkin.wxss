/* pages/checkin/checkin.wxss */
.ipt { background: #f3f4f9; border-radius: 16rpx; padding: 22rpx; font-size: 28rpx; margin-bottom: 20rpx; }

.si { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f0f5; }
.si-left { flex: 1; min-width: 0; }
.si-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.si-meta { font-size: 24rpx; color: var(--text2); margin-top: 6rpx; }
.si-btns { display: flex; gap: 14rpx; }
.mini {
  font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 999rpx;
  color: var(--accent); background: var(--accent-soft);
}
.mini.danger { color: #ff5a5a; background: rgba(255, 90, 90, .12); }

.att-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f5; }
.att-name { font-size: 28rpx; }
.att-no { font-size: 22rpx; color: var(--text2); }
.att-status { font-size: 24rpx; padding: 4rpx 18rpx; border-radius: 999rpx; }
.att-status.signed { color: #2bbf7a; background: rgba(43, 191, 122, .15); }
.att-status.absent { color: #ff5a5a; background: rgba(255, 90, 90, .15); }
.att-status.late { color: #b8860b; background: rgba(255, 193, 7, .15); }
/* 考勤明细操作按钮 */
.att-actions {
  display: flex;
  gap: 8rpx;
}
.att-btn {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
}
/* 选中的颜色 */
.att-btn.present {
  background: #e6f7ee;
  color: #2ba471;
  border-color: #2ba471;
}
.att-btn.absent {
  background: #ffecf0;
  color: #d96c8a;
  border-color: #d96c8a;
}
.att-btn.leave {
  background: #fff5e6;
  color: #e6a23c;
  border-color: #e6a23c;
}

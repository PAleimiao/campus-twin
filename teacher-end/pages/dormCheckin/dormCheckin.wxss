.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 未发起状态 ========== */
.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #FFC1D0, #FF9EB5);
  border-radius: 36rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(255, 158, 181, 0.6), 0 6rpx 14rpx #FFD0DA;
}
.hero-emoji { font-size: 100rpx; margin-bottom: 20rpx; }
.hero-title {
  font-size: 40rpx; font-weight: 700; color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(217, 108, 138, 0.4);
  margin-bottom: 12rpx;
}
.hero-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  text-align: center;
  line-height: 1.5;
}

.form-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 12rpx 26rpx -10rpx rgba(255, 183, 197, 0.5), 0 6rpx 14rpx #FFE2EC;
}
.form-row { display: flex; align-items: center; margin-bottom: 26rpx; }
.form-label { width: 140rpx; font-size: 28rpx; color: #B3546B; font-weight: 600; }
.form-input, .picker-value {
  flex: 1;
  background: #FFF7FA;
  border: 2rpx solid #FFE2EC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #5E3E4A;
}
.ph { color: #D9A8B6; }
.start-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FFB7C5, #FF9EB5);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 24rpx -8rpx #FF9EB5;
}
.start-btn::after { border: none; }

/* ========== 已发起状态 ========== */
.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #FFC1D0, #FF9EB5);
  border-radius: 36rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(255, 158, 181, 0.6), 0 6rpx 14rpx #FFD0DA;
}
.code-label { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-bottom: 12rpx; }
.code-value {
  font-size: 120rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(217, 108, 138, 0.5);
  line-height: 1.1;
  margin-bottom: 16rpx;
}
.code-topic { font-size: 28rpx; color: #FFFFFF; margin-bottom: 8rpx; }
.code-building { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-bottom: 6rpx; }
.code-time { font-size: 24rpx; color: rgba(255,255,255,0.85); }

.stats-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.stat-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 10rpx 22rpx -10rpx rgba(255, 183, 197, 0.6);
}
.stat-num { font-size: 52rpx; font-weight: 700; color: #C44B6B; line-height: 1; }
.stat-num.uncheck { color: #B18B98; }
.stat-label { font-size: 24rpx; color: #B18B98; margin-top: 12rpx; }

/* 宿舍分组 */
.list-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B3546B;
  padding: 0 8rpx 16rpx;
}
.student-list { flex: 1; max-height: 640rpx; }

.dorm-group { margin-bottom: 24rpx; }
.dorm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  background: #FFF0F5;
  border-radius: 20rpx;
  border-left: 8rpx solid #FF9EB5;
}
.dorm-left { display: flex; flex-direction: column; }
.dorm-name { font-size: 28rpx; font-weight: 700; color: #C44B6B; }
.dorm-count { font-size: 22rpx; color: #B18B98; font-weight: 500; margin-top: 4rpx; }
.dorm-check-all {
  background: linear-gradient(135deg, #FFB7C5, #FF9EB5);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 14rpx -4rpx #FF9EB5;
  flex-shrink: 0;
}

.stu-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 18rpx -10rpx rgba(255, 183, 197, 0.5);
}
.stu-avatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FFC1D0, #FF9EB5);
  color: #FFFFFF; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(255, 183, 197, 0.6);
  flex-shrink: 0;
}
.stu-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.stu-name { font-size: 28rpx; font-weight: 700; color: #5E3E4A; }
.stu-dorm-text { font-size: 22rpx; color: #B18B98; margin-top: 4rpx; }
.stu-status {
  padding: 10rpx 20rpx; border-radius: 40rpx;
  font-size: 22rpx; font-weight: 600;
}
.stu-status.ok {
  background: linear-gradient(135deg, #FFB7C5, #FF9EB5);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx -4rpx #FF9EB5;
}
.stu-status.no { background: #FFECF0; color: #B3546B; border: 1rpx solid #FFD0DA; }
.bottom-space { height: 40rpx; }

.stop-btn {
  margin-top: 24rpx;
  background: #FFFFFF;
  color: #B3546B;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: 2rpx solid #FFD0DA;
  box-shadow: 0 8rpx 18rpx -8rpx #FFD0DA;
}
.stop-btn::after { border: none; }
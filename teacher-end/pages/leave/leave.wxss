/* pages/leave/leave.wxss */
.lv-head { display: flex; align-items: center; justify-content: space-between; }
.lv-name { font-size: 32rpx; font-weight: 600; color: var(--text); }
.lv-no { font-size: 24rpx; color: var(--text2); font-weight: 400; }
.status { font-size: 24rpx; padding: 4rpx 18rpx; border-radius: 999rpx; }
.pending { color: #b8860b; background: rgba(255, 193, 7, .15); }
.approved { color: #2bbf7a; background: rgba(43, 191, 122, .15); }
.rejected { color: #ff5a5a; background: rgba(255, 90, 90, .15); }
.lv-info { font-size: 26rpx; color: var(--text2); margin-top: 10rpx; }
.lv-reason { font-size: 28rpx; color: var(--text); margin-top: 12rpx; line-height: 1.6; }
.lv-comment { font-size: 26rpx; color: var(--text2); margin-top: 10rpx; }
.btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btns .btn { flex: 1; font-size: 28rpx; padding: 16rpx 0; margin: 0; }
.ghost { background: transparent; color: var(--text2); border: 2rpx solid #ddd; }

}/* 班级切换栏 */
.switch-bar {
  padding: 16rpx 8rpx 0;
}
.switch-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 22rpx 28rpx;

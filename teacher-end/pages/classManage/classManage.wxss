  border: 2rpx solid #FFE2EC;
}
.switch-label {
  font-size: 24rpx;
  color: #B18B98;
  font-weight: 500;
}
.switch-name {
  font-size: 30rpx;
  color: #C44B6B;
  font-weight: 700;
}

/* pages/index/index.wxss */
.page { padding-bottom: 60rpx; }

/* 顶部横幅 */
.banner {
  position: relative;
  height: 340rpx;
  margin: 24rpx;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.banner-img { width: 100%; height: 100%; display: block; }
.banner-ph {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, var(--accent) 0%, #ffd1e6 100%);
}
.banner-shade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 60%;
  background: linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,0));
}
.banner-text { position: absolute; left: 32rpx; bottom: 28rpx; right: 32rpx; color: #fff; }
.banner-title { font-size: 38rpx; font-weight: 700; }
.banner-sub { font-size: 24rpx; opacity: .9; margin-top: 6rpx; }
.theme-btn {
  position: absolute; top: 24rpx; right: 24rpx;
  background: rgba(255,255,255,.9);
  color: var(--accent);
  font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 999rpx;
}

.greet { font-size: 38rpx; font-weight: 700; margin-bottom: 8rpx; }

.grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.cell {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin: 12rpx;
  width: calc(50% - 24rpx);
  box-sizing: border-box;
  padding: 28rpx 24rpx;
}
.cell-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.cell-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.cell-desc { font-size: 22rpx; color: var(--text2); margin-top: 4rpx; }

.logout { margin: 24rpx 24rpx 0; }
.my-classes-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.my-classes-left {
  flex: 1;
}
.my-classes-right {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #FFB7C5, #FF9EB5);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 18rpx -6rpx #FF9EB5;
  flex-shrink: 0;
}
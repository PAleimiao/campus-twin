<!-- pages/score/score.wxml —— 成绩录入 -->
<view class="page" style="--accent:{{theme.accent}}; --accent-soft:{{theme.soft}};">

  <view class="card">
    <view class="h2">录入成绩</view>
    <input class="ipt" placeholder="学号（如 20260001）" value="{{cur.studentNo}}" data-f="studentNo" bindinput="onField" />
    <input class="ipt" placeholder="课程名称" value="{{cur.courseName}}" data-f="courseName" bindinput="onField" />
    <input class="ipt" type="digit" placeholder="分数" value="{{cur.score}}" data-f="score" bindinput="onField" />
    <input class="ipt" placeholder="学期（如 2026秋）" value="{{cur.semester}}" data-f="semester" bindinput="onField" />
    <button class="btn-ghost" bindtap="addRow">添加到列表</button>
  </view>

  <view class="card">
    <view class="h2">待保存（{{rows.length}} 条）</view>
    <view wx:if="{{rows.length === 0}}" class="muted">还没有待保存的成绩</view>
    <view wx:else>
      <view class="row" wx:for="{{rows}}" wx:key="index">
        <view class="rinfo">{{item.studentNo}} · {{item.courseName}} · {{item.score}} 分</view>
        <view class="del" data-i="{{index}}" bindtap="removeRow">删除</view>
      </view>
    </view>
    <button class="btn save" bindtap="save">保存成绩</button>
  </view>

  <view class="card">
    <view class="h2">本班成绩（{{list.length}} 条）</view>
    <view wx:if="{{loading}}" class="muted">加载中...</view>
    <view wx:elif="{{list.length === 0}}" class="muted">还没有成绩</view>
    <block wx:else>
      <view class="row" wx:for="{{list}}" wx:key="_id">
        <view class="rinfo">{{item.name}} {{item.studentNo}} · {{item.courseName}} · {{item.score}} 分</view>
      </view>
    </block>
  </view>
</view>

/* pages/score/score.wxss */
.ipt { background: #f3f4f9; border-radius: 16rpx; padding: 22rpx; font-size: 28rpx; margin-bottom: 18rpx; }
.row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f5; }
.row:last-child { border-bottom: none; }
.rinfo { font-size: 27rpx; color: var(--text); }
.del { margin-left: auto; color: #ff5a5a; font-size: 26rpx; padding: 10rpx 20rpx; }
.save { margin-top: 20rpx; }

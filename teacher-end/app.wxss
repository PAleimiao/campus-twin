/* app.wxss —— 全局样式与设计变量（仿 CXL 避难所 / Firefly 清爽卡片风） */
/* 设计 token：颜色、圆角、阴影统一在这里改，全站生效 */
page {
  /* ★ 默认主题色：樱花粉。用户可在「主题」页切换，切换结果存本地（见 utils/theme.js） */
  --accent: #ff7eb6;
  --accent-soft: rgba(255, 126, 182, .12); /* 主题色浅底（标签药丸/选中态） */
  --bg: #f6f7fb;
  --card: #ffffff;
  --text: #1f2430;
  --text2: #8b90a0;
  --danger: #ff5a5a;
  --success: #2bbf7a;
  --radius: 24rpx;
  --shadow: 0 4rpx 20rpx rgba(40, 40, 80, .06);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin: 24rpx;
}
.btn {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  border: none;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
}
.btn-ghost::after { border: none; }
.pill {
  display: inline-block;
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-soft); /* 浅强调色底，跟随主题 */
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}
.muted { color: var(--text2); font-size: 26rpx; }
.h2 { font-size: 34rpx; font-weight: 600; margin-bottom: 8rpx; }
.page {
  background: linear-gradient(145deg, #fff0f5 0%, #ffe4ec 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
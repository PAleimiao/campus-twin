# ===== 依赖与运行时（体积巨大，不进仓库，克隆后按 README 自己装）=====
node_modules/
**/node_modules/
.runtime/
local-ai/

# ===== 密钥 / 环境配置（绝不入库，仓库只留 *.example.*）=====
ai.config.json
ai.key
*.key
.env
.env.*

# ===== 本地运行数据（含密码哈希等，运行时自动生成）=====
local-server/data/*.json
local-server/data/*.tmp
local-server/data/*.bad
local-server/public/uploads/*
!local-server/public/uploads/.gitkeep

# ===== 工具 / IDE / 系统产物 =====
.codebuddy/
.cloudbase/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.crdownload
